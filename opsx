#!/usr/bin/env python3
"""opsx CLI——core.py 的薄壳。"""
from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import shutil
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import core  # noqa: E402
import remote  # noqa: E402


def _join(parts: list[str]) -> str:
    return " ".join(parts)


def _guarded_cli(command: str) -> bool:
    # 仅豁免无 shell 展开/拼接的本仓库入口；内层命令由 exec/snapshot 自行守门。
    word = r'''(?:[\w./:=,+@%~-]|'[^']*'|"[^"$`\\]*")+'''
    if not re.fullmatch(rf"[ \t]*{word}(?:[ \t]+{word})*[ \t]*", command):
        return False
    argv = shlex.split(command)
    if not argv:
        return False
    exe = Path(argv[0]).expanduser() if "/" in argv[0] else Path(shutil.which(argv[0]) or "/")
    if exe.resolve() == Path(sys.executable).resolve() and len(argv) > 1:
        argv = argv[1:]
        exe = Path(argv[0]).expanduser()
    return (exe.resolve() == core.REPO_DIR / "opsx" and len(argv) > 1
            and argv[1] in {"check", "approve", "revoke", "exec", "snapshot", "rollback",
                            "scenario", "list", "targets", "audit", "selftest"})


def _print_execution(cmd: str, target: str | None = None,
                     since: float | None = None) -> None:
    """打印**本次**变更的 execution_id：断线/超时之后，人靠它查"到底改完了没有"。

    since 是调用前的时刻：被门禁挡下（审批用尽/锁冲突）时不会产生新记录，
    此时不该把上一条成功记录当成"本次结果"打出来。
    """
    import execution
    record = execution.find_latest(cmd, target, since=since, pid=os.getpid(), kind="exec")
    if record is None:
        return
    print(f"[opsx] execution_id: {record['id']}（{record['status']}；"
          f"查看: opsx executions show {record['id']}）")


def _print_rollback_execution(snapshot_id: str, target: str | None = None,
                              since: float | None = None) -> None:
    import execution
    record = execution.find_latest(f"rollback {snapshot_id}", target, since=since,
                                   pid=os.getpid(), kind="rollback")
    if record is not None:
        print(f"[opsx] execution_id: {record['id']}（{record['status']}；"
              f"查看: opsx executions show {record['id']}）")


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(prog="opsx", description="运维变更守门：分类/审批戳/快照/回滚/审计")
    sub = p.add_subparsers(dest="sub", required=True)

    c = sub.add_parser("check", help="hook 入口：判定命令并输出放行/拒绝")
    c.add_argument("command", nargs="+")

    a = sub.add_parser("approve", help="手动预授权（降级路径）")
    a.add_argument("command", nargs="+")
    a.add_argument("--ttl", type=int, default=900, help="有效期秒数")
    a.add_argument("--force", action="store_true", help="R3 不可逆操作必须显式加此 flag")
    a.add_argument("--target", default="", help="SSH 目标名（戳只对该目标有效）；省略=本机")
    a.add_argument("--uses", type=int, default=1,
                   help="该授权允许执行几次（默认 1：一次批准只生效一次）")

    rv = sub.add_parser("revoke", help="撤销审批戳（用户取消变更）")
    rv.add_argument("command", nargs="+")
    rv.add_argument("--target", default="", help="SSH 目标名；省略=本机")

    e = sub.add_parser("exec", help="原子执行：校验→快照→执行→审计")
    e.add_argument("command", nargs="+")
    e.add_argument("--target", default="", help="SSH 目标名；省略=本机")
    e.add_argument("--snapshot-file", action="append", default=[])
    e.add_argument("--snapshot-cmd", action="append", default=[],
                   help="'name::command' 形式，可多次")
    e.add_argument("--wait-lock", type=float, default=0.0, metavar="SECONDS",
                   help="等待同目标其它变更结束的秒数（默认 0：立即失败）")

    s = sub.add_parser("snapshot", help="独立快照")
    g = s.add_mutually_exclusive_group(required=True)
    g.add_argument("--file")
    g.add_argument("--cmd")
    s.add_argument("--name", default="")
    s.add_argument("--target", default="", help="SSH 目标名；省略=本机")

    ex = sub.add_parser("executions", help="变更执行记录：list / show / resolve（核实 unknown）")
    ex.add_argument("action", nargs="?", default="list",
                    choices=["list", "show", "resolve"])
    ex.add_argument("execution_id", nargs="?", default="")
    ex.add_argument("--tail", type=int, default=20)
    ex.add_argument("--status", default="", choices=["", "running", "succeeded", "failed",
                                                    "unknown", "aborted"])
    ex.add_argument("--target", default="", help="只看某个目标")
    ex.add_argument("--observed-ok", action="store_true", help="核实：变更已生效")
    ex.add_argument("--observed-failed", action="store_true", help="核实：变更未生效")
    ex.add_argument("--note", default="", help="核实备注（记入审计）")

    r = sub.add_parser("rollback")
    r.add_argument("snapshot_id")
    r.add_argument("--yes", action="store_true", help="已确认回滚计划，非交互环境必须显式指定")

    sc = sub.add_parser(
        "scenario", help="固定变更场景：预检→快照→执行→后验→回滚建议",
        epilog="run 退出码：0 通过｜1 执行失败｜2 需审批/守门拒绝/需确认动作｜"
               "3 预检未通过｜4 快照未建成｜7 验证失败（exit=0 但后验不健康）｜"
               "120 结果未知或有未核实执行｜121 目标被占用")
    sc.add_argument("action", choices=["list", "show", "run", "rollback"])
    sc.add_argument("name", nargs="?", default="",
                    help="场景名（run/rollback 时为场景名或执行记录 id）")
    sc.add_argument("--param", action="append", default=[], metavar="K=V",
                    help="场景参数，可多次")
    sc.add_argument("--target", default="", help="SSH 目标名；省略=场景声明或本机")
    sc.add_argument("--wait-lock", type=float, default=0.0, metavar="SECONDS")
    sc.add_argument("--yes", action="store_true",
                    help="scenario rollback：已核对回滚计划，必须显式指定"
                         "（未加 --yes 时展示计划并退出 2，与需审批同码：都需人工动作）")

    sub.add_parser("list", help="列出快照、审批戳与 SSH 目标")
    sub.add_parser("targets", help="列出已注册的 SSH 目标")

    at = sub.add_parser("audit")
    at.add_argument("--tail", type=int, default=20)

    sub.add_parser("selftest", help="运行内置自检")

    sub.add_parser("hook", help="Claude Code PreToolUse hook 入口（stdin 读 JSON）")

    args = p.parse_args(argv)
    started = None

    try:
        if args.sub == "hook":
            try:
                data = json.load(sys.stdin)
                command = data.get("tool_input", {}).get("command", "")
                if not command.strip():
                    print("[opsx] hook: 空命令，拒绝执行", file=sys.stderr)
                    return 2
                if _guarded_cli(command):
                    core.audit("hook", cmd=command, result="allow-guarded-cli")
                    return 0
                code, msg = core.check(command)
                if code == 0 and core.classify(command)[0] != "R0":
                    # hook 无法持锁到外部 Bash 结束，也不能在预检时消耗审批。
                    code = 2
                    msg = ("[opsx] 写操作必须通过 opsx exec 执行：裸命令会绕过审批次数、"
                           "目标写锁和执行记录。审批戳保留，未消耗。")
                    core._safe_audit("hook", cmd=command, result="deny-raw-change")
                if code != 0:
                    print(msg, file=sys.stderr)
                return code
            except Exception as e:  # noqa: BLE001 —— hook 异常一律拒绝方向
                print(f"[opsx] hook 异常，拒绝执行: {core.redact(str(e))}", file=sys.stderr)
                return 2

        if args.sub == "check":
            code, msg = core.check(_join(args.command))
            print(msg, file=sys.stderr if code else sys.stdout)
            return code

        if args.sub == "approve":
            if args.target:
                remote.get_target(args.target)  # 只允许给注册过的目标建戳
            path = core.approve(_join(args.command), ttl_seconds=args.ttl,
                                force=args.force, target=args.target or None,
                                uses=args.uses)
            stamp = json.loads(path.read_text(encoding="utf-8"))
            print(f"已授权（级别 {stamp['level']}，TTL {args.ttl}s，可用 {args.uses} 次，"
                  f"{core.format_env(stamp['env'])}）")
            return 0

        if args.sub == "revoke":
            existed = core.revoke(_join(args.command), args.target or None)
            where = f"目标 {args.target}" if args.target else "本机"
            print(f"已撤销{where}的审批戳" if existed else f"无匹配的审批戳（{where}，可能已过期）")
            return 0

        if args.sub == "exec":
            snap_cmds = []
            for spec in args.snapshot_cmd:
                name, _, cmd = spec.partition("::")
                if not _:
                    name, cmd = "", spec
                if not cmd.strip():
                    raise core.OpsxError("快照命令不能为空")
                snap_cmds.append((cmd, name))
            cmd = _join(args.command)
            started = time.time()
            if args.target:
                code, sid, output = remote.exec_change(args.target, cmd, args.snapshot_file,
                                                       snap_cmds, lock_wait=args.wait_lock)
            else:
                code, sid, output = core.exec_change(cmd, args.snapshot_file, snap_cmds,
                                                     lock_wait=args.wait_lock)
            if output:
                output = core.redact(output)
                print(output, end="" if output.endswith("\n") else "\n")
            if sid:
                print(f"[opsx] snapshot_id: {sid}（回滚: opsx rollback {sid}）")
            _print_execution(cmd, args.target or None, since=started)
            return code

        if args.sub == "executions":
            import execution
            execution.reconcile()  # 先对账：daemon/进程被杀留下的 running 要变成 unknown
            if args.action == "list":
                if args.tail <= 0:
                    raise core.OpsxError("tail 须为正整数（0 会显示「无执行记录」，误导）")
                summary = execution.summary(target=args.target or None)
                print(execution.format_list(execution.list_records(
                    tail=args.tail, target=args.target or None,
                    status=args.status or None)))
                if summary["pending"]:
                    # 待核实项必须显眼：它们会挡住同目标同命令的再次执行
                    print(f"\n[opsx] 有 {summary['pending']} 条待核实（unknown）："
                          f"{', '.join(summary['pending_ids'])}")
                    print("[opsx] 同目标同命令的新执行会被拒绝，直到核实："
                          "opsx executions resolve <id> --observed-ok|--observed-failed")
                return 0
            if not args.execution_id:
                raise core.OpsxError("需要 execution_id")
            record = execution.get(args.execution_id)
            if record is None:
                raise core.OpsxError(f"没有这条执行记录: {args.execution_id}")
            if args.action == "show":
                print(execution.format_record(record))
                return 0
            if args.observed_ok and args.observed_failed:
                raise core.OpsxError("--observed-ok 与 --observed-failed 只能选一个")
            if not (args.observed_ok or args.observed_failed):
                raise core.OpsxError("核实必须明确 --observed-ok 或 --observed-failed")
            outcome = "observed-ok" if args.observed_ok else "observed-failed"
            execution.resolve(args.execution_id, outcome, args.note)
            print(f"已核实 {args.execution_id}：{outcome}")
            if outcome == "observed-failed":
                print("该命令未生效；如需真正执行，请重新批准后再次执行（旧的审批戳已用掉）。")
            else:
                print("该命令已生效；不要重复执行同一条命令（会二次生效）。")
            return 0

        if args.sub == "snapshot":
            if args.target:
                sid = (remote.snapshot_file(args.target, args.file) if args.file
                       else remote.snapshot_cmd(args.target, args.cmd, args.name))
            else:
                sid = core.snapshot_file(args.file) if args.file else core.snapshot_cmd(args.cmd, args.name)
            print(sid)
            return 0

        if args.sub == "rollback":
            plan = remote.rollback_plan(args.snapshot_id)
            if plan["files"]:
                print(core.redact(core.format_rollback_plan(plan)))
                if not args.yes:
                    if not sys.stdin.isatty():
                        raise core.OpsxError(
                            "非交互环境回滚需加 --yes（先确认上面的回滚计划）")
                    try:
                        answer = input("确认回滚？输入 yes 执行：")
                    except EOFError:
                        answer = ""
                    if answer.strip().casefold() not in {"yes", "y", "确认回滚", "确认"}:
                        print("[opsx] 已取消，文件未改动", file=sys.stderr)
                        return 1
            started = time.time()
            print(core.redact(remote.rollback(args.snapshot_id, confirm=True)))  # 远程推回
            _print_rollback_execution(args.snapshot_id, plan.get("target"), since=started)
            return 0

        if args.sub == "scenario":
            import scenario
            if args.action == "list":
                entries = scenario.catalog()
                if not entries:
                    print("(无场景定义；内置在 scenarios/*.json，自定义放 "
                          f"{scenario.dirs()[0]}/*.json)")
                    return 0
                for entry in entries:
                    params = (f"（参数: {', '.join(entry['params'])}）"
                              if entry["params"] else "")
                    print(f"{entry['name']}{params} — {entry['description']}")
                return 0
            if args.action == "show":
                print(json.dumps(scenario.load(args.name), ensure_ascii=False, indent=2))
                return 0
            if args.action == "run":
                params = {}
                for spec in args.param:
                    key, sep, value = spec.partition("=")
                    if not sep or not key.strip():
                        raise core.OpsxError(f"--param 须为 K=V 形式: {spec!r}")
                    params[key.strip()] = value
                result = scenario.run(args.name, params, target=args.target or None,
                                      actor="cli", lock_wait=args.wait_lock)
                print(scenario.format_result(result, with_suggestion=True))
                # 退出码：0 通过 / 1 执行失败 / 2 需审批或需确认动作 /
                # 3 预检未通过 / 7 验证失败 / 120 结果未知或存在未核实执行 /
                # 121 目标被占用。gate_denied 复用 2（都是"需要人工动作"）。
                return {"ok": 0, "exec_failed": 1, "approval_required": 2,
                        "gate_denied": 2, "precheck_failed": 3,
                        "snapshot_failed": 4, "verify_failed": 7,
                        "busy": 121, "uncertain": 120}.get(result["verdict"], 1)
            # rollback：先展示计划再要 --yes（与 opsx rollback 同确认语义）
            import execution
            record = execution.get(args.name)
            if record is None:
                raise core.OpsxError(f"没有这条执行记录: {args.name!r}")
            if not record.get("snapshot_id"):
                raise core.OpsxError("该执行记录没有关联快照，没有可回滚的内容")
            if not args.yes:
                plan = remote.rollback_plan(record["snapshot_id"])
                print(core.redact(core.format_rollback_plan(plan)))
                print("\n回滚是写操作：确认后加 --yes 执行。")
                return 2
            result = scenario.rollback(args.name, confirm=True)
            print(scenario._format_rollback(result))
            return 0

        if args.sub == "targets":
            print("\n".join(remote.describe()) or "(未注册目标)")
            print(f"[opsx] 注册文件: {core.STATE_DIR / 'targets.json'}")
            return 0

        if args.sub == "list":
            targets = remote.describe() or ["(未注册)"]
            print("\n".join(core.format_state(core.collect_state()) + ["== targets =="] + targets))
            return 0

        if args.sub == "audit":
            if args.tail < 0:
                raise core.OpsxError("tail 不能为负数")
            f = core.STATE_DIR / "audit.jsonl"
            if not f.exists():
                print("(无审计日志)")
                return 0
            lines = f.read_text(encoding="utf-8").strip().splitlines()
            for line in lines[-args.tail:] if args.tail else []:
                print(line)
            return 0

        if args.sub == "selftest":
            import selftest
            return selftest.main()

    except (core.OpsxError, remote.RemoteError) as e:
        print(f"[opsx] 错误: {core.redact(str(e))}", file=sys.stderr)
        if started is not None:
            if args.sub == "exec":
                _print_execution(cmd, args.target or None, since=started)
            elif args.sub == "rollback":
                _print_rollback_execution(args.snapshot_id, plan.get("target"), since=started)
        return core.EXEC_ABORT_LOCK if isinstance(e, core.TargetBusy) else 1


if __name__ == "__main__":
    raise SystemExit(main())
