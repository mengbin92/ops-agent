#!/usr/bin/env python3
"""opsagent —— ops-agent 独立智能体入口。

形态：
  opsagent                      交互式 REPL（默认）
  opsagent chat                 同上
  opsagent -p "查看 nginx 状态"  单发非交互（可进脚本/CI）
  opsagent rpc                  stdio JSON-RPC 长驻进程
  opsagent inspect ...          确定性巡检（连通性/资源/服务，规则检查不依赖 LLM）
  opsagent schedule ...         定时巡检：list / add / remove / run（--once 适合 cron）
  opsagent notify ...           单渠道通知：setup / test / list / retry / mute
  opsagent events ...           事件时间线：异常、恢复、通知与运行状态变化
  opsagent a2a ...              A2A 协议形态：serve / card / call / doctor（需 requirements-a2a.txt）
"""
from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import core  # noqa: E402
from agent import loop, repl, rpc, session as sess_mod, tools  # noqa: E402


def _print_mode(prompt: str, model: str | None) -> int:
    """单发：无 TTY 时 ask_user 不可用，写操作安全方向降级为拒绝。"""
    try:
        session = sess_mod.Session()
        if not sys.stdin.isatty():
            ctx = tools.ToolContext(ask_user=None, model=model, session_id=session.id)
        else:
            ctx = tools.ToolContext(
                ask_user=lambda q: input(f"\n{q}\n你的回答> ").strip(), model=model,
                session_id=session.id)
        text = loop.run_turn(prompt, session, ctx, model=model)
    except loop.llm.LLMError as e:
        print(f"[LLM 错误] {tools.core.redact(str(e))}", file=sys.stderr)
        return 1
    except (OSError, ValueError) as e:
        print(f"[opsagent] 错误: {core.redact(str(e))}", file=sys.stderr)
        return 1
    print(text)
    return 0


def _budget_cli(usage, argv: list[str]) -> int:
    """opsagent budget：status 查看 / set 调整 / recent 最近调用。"""
    import argparse
    parser = argparse.ArgumentParser(prog="opsagent budget",
                                     description="LLM 调用预算（按本机自然日滚动）")
    sub = parser.add_subparsers(dest="cmd", required=True)
    sub.add_parser("status", help="今日用量与上限")
    set_p = sub.add_parser("set", help="调整预算")
    set_p.add_argument("--calls", type=int, default=None, metavar="N",
                       help="每日调用次数上限（0=不限）")
    set_p.add_argument("--tokens", type=int, default=None, metavar="N",
                       help="每日 token 上限（0=不限）")
    set_p.add_argument("--enable", action="store_true", help="启用预算")
    set_p.add_argument("--disable", action="store_true", help="停用预算（不限制调用）")
    rec = sub.add_parser("recent", help="最近调用记录")
    rec.add_argument("--tail", type=int, default=20)
    args = parser.parse_args(argv)
    try:
        if args.cmd == "status":
            print(usage.format_status())
            return 0
        if args.cmd == "recent":
            if args.tail < 0:
                raise core.OpsxError("tail 不能为负数")
            records = usage.recent(tail=args.tail)
            if not records:
                print("(无调用记录)")
                return 0
            for r in records:
                est = "（估）" if r.get("estimated") else ""
                print(core.redact(f"{r.get('day', '?')}  {r.get('model', '?')}  "
                      f"{r.get('prompt_tokens', 0)}+{r.get('completion_tokens', 0)}"
                      f" tok{est}  {r.get('source', '')}"))
            return 0
        # set
        cfg = usage.load_budget()
        if args.calls is not None:
            if args.calls < 0:
                raise core.OpsxError("--calls 不能为负（0=不限）")
            cfg["daily_calls"] = args.calls or None
        if args.tokens is not None:
            if args.tokens < 0:
                raise core.OpsxError("--tokens 不能为负（0=不限）")
            cfg["daily_tokens"] = args.tokens or None
        if args.enable and args.disable:
            raise core.OpsxError("--enable 与 --disable 二选一")
        if args.enable:
            cfg["enabled"] = True
        if args.disable:
            cfg["enabled"] = False
        path = usage.save_budget(cfg)
        print(f"已写入 {path}（0600）")
        print(usage.format_status())
        return 0
    except (core.OpsxError, OSError) as e:
        print(f"[budget] 错误: {core.redact(str(e))}", file=sys.stderr)
        return 1


def _events_cli(argv: list[str]) -> int:
    """事件时间线查询：只读，读 ~/.ops-agent/events.jsonl。"""
    import argparse
    from agent import events
    p = argparse.ArgumentParser(prog="opsagent events",
                                description="查看事件时间线（异常/恢复/通知/运行状态变化）")
    p.add_argument("--tail", type=int, default=events.TAIL_DEFAULT, help="条数（默认 30）")
    p.add_argument("--kind", default=None, help="只看某类事件（如 anomaly-new / notify-failed）")
    args = p.parse_args(argv)
    if args.tail < 0:
        print("[events] 错误: tail 不能为负数", file=sys.stderr)
        return 1
    print(events.format_tail(n=args.tail, kind=args.kind))
    return 0


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv[:1] == ["schedule"]:  # 子命令有自己的参数解析，先分流
        from agent import schedule
        return schedule.cli(argv[1:])
    if argv[:1] == ["inspect"]:
        from agent import checks
        return checks.cli(argv[1:])
    if argv[:1] == ["notify"]:
        from agent import notify
        return notify.cli(argv[1:])
    if argv[:1] == ["events"]:
        from agent import events
        return _events_cli(argv[1:])
    if argv[:1] == ["doctor"]:
        import doctor
        return doctor.cli(argv[1:])
    if argv[:1] == ["budget"]:
        import usage
        return _budget_cli(usage, argv[1:])
    if argv[:1] == ["a2a"]:  # 协议形态：serve / card / call / doctor
        from agent import a2a_cli
        return a2a_cli.cli(argv[1:])
    p = argparse.ArgumentParser(prog="opsagent", description="ops-agent 独立运维智能体",
                                epilog="巡检：opsagent inspect [--target all]；"
                                       "定时：opsagent schedule [status|list|add|run]；"
                                       "通知：opsagent notify [status|test|list|retry|mute]；"
                                       "事件：opsagent events [--tail 30]；"
                                       "体检：opsagent doctor；预算：opsagent budget [status|set|recent]")
    p.add_argument("--model", help="覆盖默认模型（或设 OPSAGENT_MODEL）")
    p.add_argument("-p", "--print", dest="oneshot", metavar="PROMPT", help="单发非交互模式")
    p.add_argument("mode", nargs="?", default="chat", choices=["chat", "rpc"], help="运行形态")
    args = p.parse_args(argv)

    if args.oneshot is not None:
        return _print_mode(args.oneshot, args.model)
    if args.mode == "rpc":
        rpc.serve(model=args.model)
        return 0
    return repl.main(model=args.model)


if __name__ == "__main__":
    raise SystemExit(main())
