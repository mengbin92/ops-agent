{
  "description": "重启 docker 容器并验证 running 且健康（有 healthcheck 时等它给出结论，starting 也算进行中）",
  "params": {
    "container": {"required": true, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
                  "description": "容器名"}
  },
  "precheck": [
    {"cmd": "docker inspect --format '{{.State.Status}}' {container}", "expect": "running"}
  ],
  "exec": {
    "cmd": "docker restart {container}"
  },
  "postcheck": [
    {"cmd": "docker inspect --format '{{.State.Status}}/{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' {container}",
     "expect_regex": "^running/(healthy|none|starting)$"}
  ]
}
