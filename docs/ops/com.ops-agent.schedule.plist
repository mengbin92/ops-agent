<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd（macOS）。安装：
     cp docs/ops/com.ops-agent.schedule.plist ~/Library/LaunchAgents/
     编辑 ProgramArguments 与 EnvironmentVariables 后：
     launchctl load ~/Library/LaunchAgents/com.ops-agent.schedule.plist
     排障：launchctl list | grep ops-agent；日志在 StandardErrorPath -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ops-agent.schedule</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/opsagent</string>
        <string>schedule</string>
        <string>run</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>OPSAGENT_API_KEY</key>
        <string>换成真实密钥</string>
    </dict>
    <!-- 异常退出时拉起；包括持锁退出（exit 3），每次至少间隔 60 秒。
         不要同时运行另一份 daemon 或 timer。 -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <key>StandardOutPath</key>
    <string>/Users/你的用户名/Library/Logs/opsagent-schedule.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/你的用户名/Library/Logs/opsagent-schedule.err</string>
</dict>
</plist>
