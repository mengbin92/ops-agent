# 与 opsagent-schedule.timer 配套的 one-shot 服务（不要和常驻 service 混用）
[Unit]
Description=ops-agent scheduled inspection (one-shot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# 与常驻 service 使用同一个运行用户；系统服务不设 User 会以 root 运行。
# User=yourname
ExecStart=/usr/local/bin/opsagent schedule run --once
EnvironmentFile=-/etc/ops-agent/env
UMask=0077
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=false
